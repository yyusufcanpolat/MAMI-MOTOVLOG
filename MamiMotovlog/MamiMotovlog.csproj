<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MamiMotovlog</RootNamespace>
    <AssemblyName>MamiMotovlog</AssemblyName>
    <UserSecretsId>mamimotovlog-local-dev-2026</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Production.json;appsettings.Development.json;appsettings.Local.json;App_Data/**;wwwroot/uploads/**;logs/**;keys/**" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
