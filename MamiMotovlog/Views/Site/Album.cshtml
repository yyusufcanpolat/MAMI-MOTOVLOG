@model Album
<section class="page-hero page-hero-small shell"><span class="overline"><a href="/galeri">FOTOĞRAF GALERİSİ</a> / @Model.Photos.Count KARE</span><h1 class="detail-heading">@Model.Title</h1><p>@Model.Description</p></section>
<section class="shell photo-page">@if(Model.Ride is not null && Model.Ride.IsPublished){<a class="related-route" href="/rotalar/@Model.Ride.Id">BU ALBÜMÜN GEZİ YAZISINA GİT ↗</a>}<div class="photo-grid">@foreach(var p in Model.Photos.OrderBy(x=>x.SortOrder)) {<button type="button" class="photo-tile" data-lightbox-src="@p.ImagePath" data-lightbox-caption="@p.Caption" aria-label="@p.Caption fotoğrafını büyüt"><img src="@p.ImagePath" loading="lazy" alt="@p.Caption"/><span>İNCELE ↗</span></button>}</div></section>
<div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Fotoğraf görüntüleyici"><button class="lightbox-close" aria-label="Kapat">✕</button><button class="lightbox-prev" aria-label="Önceki fotoğraf">←</button><figure><img src="" alt=""/><figcaption></figcaption></figure><button class="lightbox-next" aria-label="Sonraki fotoğraf">→</button></div>
