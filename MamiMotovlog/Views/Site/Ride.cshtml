@model DetailRideVm
<section class="page-hero page-hero-small shell"><span class="overline"><a href="/rotalar">GEZİ ROTALARI</a> / YOL HİKÂYESİ</span><h1 class="detail-heading">@Model.Ride.Title</h1><p>@Model.Ride.Summary</p></section>
<section class="shell ride-story"><div class="route-facts"><span>ROTANIN ÖZETİ</span><div><small>BAŞLANGIÇ</small><strong>@(string.IsNullOrEmpty(Model.Ride.StartPoint)?"—":Model.Ride.StartPoint)</strong></div><div><small>VARIŞ</small><strong>@(string.IsNullOrEmpty(Model.Ride.EndPoint)?"—":Model.Ride.EndPoint)</strong></div><div><small>MESAFE</small><strong>@(Model.Ride.DistanceKm.HasValue?$"{Model.Ride.DistanceKm} KM":"—")</strong></div>@if(!string.IsNullOrEmpty(Model.Ride.Stops)){<div><small>DURAKLAR</small><strong>@Model.Ride.Stops</strong></div>}@if(!string.IsNullOrEmpty(Model.Ride.MapUrl)){<a href="@Model.Ride.MapUrl" target="_blank" rel="noopener noreferrer">HARİTAYI AÇ ↗</a>}</div><div class="ride-article"><span class="overline">@(Model.Ride.Title.StartsWith("Rota rehberi:") ? "ÖNERİ ROTA / GEZİ REHBERİ" : "YOL GÜNLÜĞÜ / " + Model.Ride.CreatedAt.ToString("dd.MM.yyyy"))</span><p class="preline">@Model.Ride.Story</p>@if(Model.Videos.Count>0){<h3>BU ROTADAN VİDEOLAR</h3>@foreach(var v in Model.Videos){<a class="article-related" href="/videolar/@v.Id">@v.Title ↗</a>}}@if(Model.Albums.Count>0){<h3>FOTOĞRAF ALBÜMLERİ</h3>@foreach(var a in Model.Albums){<a class="article-related" href="/galeri/@a.Id">@a.Title ↗</a>}}</div></section>
