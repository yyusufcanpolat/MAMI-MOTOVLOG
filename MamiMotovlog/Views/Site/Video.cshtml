@model DetailVideoVm
<section class="page-hero page-hero-small shell"><span class="overline"><a href="/videolar">VİDEOLAR</a> / MOTOVLOG</span><h1 class="detail-heading">@Model.Video.Title</h1><p>@Model.Video.Summary</p></section>
<section class="shell watch-section"><div class="youtube-wrapper"><iframe src="https://www.youtube-nocookie.com/embed/@Model.YoutubeId" title="@Model.Video.Title" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div class="watch-links"><span>PAYLAŞIM / @Model.Video.CreatedAt.ToString("dd.MM.yyyy")</span>@if(Model.Video.Ride is not null && Model.Video.Ride.IsPublished){<a href="/rotalar/@Model.Video.Ride.Id">İLGİLİ GEZİ YAZISI ↗</a>}@if(Model.LinkedAlbum is not null){<a href="/galeri/@Model.LinkedAlbum.Id">İLGİLİ FOTOĞRAF ALBÜMÜ ↗</a>}</div></section>
