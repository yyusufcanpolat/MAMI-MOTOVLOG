@model List<RiderTrip>
@{ ViewData["Title"] = "Topluluk rotaları"; var favorites = (HashSet<int>)ViewBag.FavoriteIds; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">MAMI / TOPLULUK</p><h1>YOL <em>PAYLAŞTIKÇA.</em></h1><p>Sürücülerin önerdiği ve moderasyon onayından geçen güzergâhlar. Her rotayı kendi koşullarına göre yeniden değerlendir.</p></div>
<form class="rider-year-filter" method="get" action="/topluluk/rotalar"><label>Rota ara<input name="q" maxlength="75" value="@ViewBag.Query" placeholder="Şehir veya rota adı" /></label><button class="rider-btn">ARA ↗</button></form>
<div class="rider-section-head"><h2>@Model.Count PAYLAŞILAN ROTA</h2><a href="/rota-planlayici" class="rider-btn">ROTAMI PLANLA ↗</a></div><div class="rider-cards">@foreach(var t in Model){<article class="rider-panel rider-trip-card"><span class="overline">TOPLULUK ROTASI</span><h2>@t.Title</h2><p>@t.StartLabel → @t.EndLabel</p><div><strong>@t.DistanceKm.ToString("N1") KM</strong><small>@(t.DurationMinutes >= 60 ? $"{t.DurationMinutes / 60} saat {(t.DurationMinutes % 60 > 0 ? $"{t.DurationMinutes % 60} dk" : "")}".Trim() : $"{t.DurationMinutes} dk")</small></div><a href="/topluluk/rotalar/@t.Id">ROTAYI GÖR ↗</a>@if((bool)ViewBag.CanFavorite){<form method="post" action="/topluluk/rotalar/@t.Id/favori">@Html.AntiForgeryToken()<button class="rider-btn rider-btn-ghost">@(favorites.Contains(t.Id)?"♥ FAVORİDEN ÇIKAR":"♡ FAVORİYE EKLE")</button></form>}</article>}</div>@if(!Model.Any()){<div class="rider-panel"><p>Henüz onaylanmış topluluk rotası yok.</p></div>}</section>
