@model List<RiderTrip>
@{ ViewData["Title"] = "Sürüş geçmişim"; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER HUB / SÜRÜŞLER</p><h1>GERİDE KALAN <em>KİLOMETRELER.</em></h1></div>@await Html.PartialAsync("_RiderMenu")
<div class="rider-section-head"><h2>@Model.Count KAYITLI ROTA</h2><a href="/rota-planlayici" class="rider-btn">＋ YENİ ROTA</a></div><div class="rider-cards">@foreach(var t in Model){<a class="rider-panel rider-trip-card" href="/garaj/rotalar/@t.Id"><span class="overline">@(t.CompletedOn.HasValue?"TAMAMLANDI":"PLANLANDI")</span><h2>@t.Title</h2><p>@t.StartLabel → @t.EndLabel</p><div><strong>@t.DistanceKm.ToString("N1") KM</strong><small>@(t.DurationMinutes >= 60 ? $"{t.DurationMinutes / 60} saat {(t.DurationMinutes % 60 > 0 ? $"{t.DurationMinutes % 60} dk" : "")}".Trim() : $"{t.DurationMinutes} dk")</small></div><b>İNCLELE ↗</b></a>}</div>@if(!Model.Any()){<div class="rider-panel">Henüz rota kaydetmedin. <a href="/rota-planlayici">Rota planlayıcıya git →</a></div>}</section>
