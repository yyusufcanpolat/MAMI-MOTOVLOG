@model RiderTrip
@using System.Security.Claims
@{ViewData["Title"] = Model.Title; var isOwner=User.FindFirstValue(ClaimTypes.NameIdentifier)==Model.OwnerId;}
<section class="rider-shell"><div class="rider-intro"><p class="overline">MAMI / ROTA DOSYASI</p><h1>@Model.Title.ToUpperInvariant()</h1><p>@Model.StartLabel → @Model.EndLabel</p></div>
@if(isOwner){@await Html.PartialAsync("_RiderMenu")}
@if(TempData["RiderInfo"] is string info){<p class="rider-flash">@info</p>}
<div class="rider-stat-grid"><div><span>MESAFE</span><strong>@Model.DistanceKm.ToString("N1")</strong><small>km</small></div><div><span>TAHMİNİ SÜRE</span><strong>@(Model.DurationMinutes >= 60 ? $"{Model.DurationMinutes / 60} saat {(Model.DurationMinutes % 60 > 0 ? $"{Model.DurationMinutes % 60} dk" : "")}".Trim() : $"{Model.DurationMinutes} dk")</strong><small>tahmini sürüş</small></div><div><span>DURUM</span><strong>@(isOwner && Model.CompletedOn.HasValue?"✓":"↗")</strong><small>@(isOwner ? (Model.CompletedOn?.ToString("dd.MM.yyyy")??"Planlandı") : "Paylaşılan rota")</small></div><div><span>TOPLULUK</span><strong>@(Model.IsApproved&&Model.IsPublic?"AÇIK":"ÖZEL")</strong><small>@(Model.IsPublic&&!Model.IsApproved?"İnceleme bekliyor":"")</small></div></div>
<div class="rider-two"><section class="rider-panel"><h2>GÜZERGÂH</h2><div class="rider-route-preview" id="trip-preview"></div><p class="rider-muted">Güzergâh çizimi yaklaşık planlama verisidir.</p>
</section><section class="rider-panel"><h2>SÜRÜŞ GÜNLÜĞÜ</h2>@if(isOwner && Model.CompletedOn.HasValue){<p><b>@Model.CompletedOn.Value.ToString("dd.MM.yyyy")</b> tarihinde tamamlandı.</p><p>@Model.Journal</p><p>Gerçek masraf: @(Model.ActualSpendTry?.ToString("N2")??"—") ₺</p>}
@if(isOwner){<form class="rider-form" method="post" action="/garaj/rotalar/@Model.Id/tamamla">@Html.AntiForgeryToken()<label>Sürüş tarihi<input type="date" name="date" required value="@(Model.CompletedOn?.ToString("yyyy-MM-dd")??MamiMotovlog.Services.TurkeyClock.Today.ToString("yyyy-MM-dd"))" /></label><label>Gerçek masraf ₺<input type="number" step="0.01" min="0" name="spendTry" value="@Model.ActualSpendTry" /></label><label>Yol notları<textarea name="journal" maxlength="2000" rows="4">@Model.Journal</textarea></label><button class="rider-btn">SÜRÜŞÜ KAYDET ↗</button></form>
 <hr/><form method="post" action="/garaj/rotalar/@Model.Id/paylas">@Html.AntiForgeryToken()<button class="rider-btn rider-btn-ghost">@(Model.IsPublic?"TOPLULUKTAN KALDIR":"TOPLULUKTA PAYLAŞIM İSTE")</button></form>
 <form class="rider-danger" method="post" action="/garaj/rotalar/@Model.Id/sil" data-confirm="Rotayı silmek istiyor musun?">@Html.AntiForgeryToken()<button>ROTAYI SİL</button></form>}
else {<p class="rider-muted">Toplulukta paylaşılan rota.</p>}
</section></div></section>
@section Head { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyo2ItGsV9Y0nS2jS=" crossorigin="" /><link rel="stylesheet" href="/css/leaflet-layout-fallback.css" asp-append-version="true" /> }
@section Scripts { <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script><script id="trip-geo" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GeoJson))</script><script src="/js/rider-trip.js" asp-append-version="true" defer></script> }