@{Layout="_AdminLayout"; ViewData["Title"]="Rider Hub yönetimi";
var brands=(List<BikeBrand>)ViewBag.Brands;
var pending=(List<RiderTrip>)ViewBag.PendingRoutes;}
<section class="rider-shell"><partial name="_AdminNav"/><div class="rider-intro"><p class="overline">MAMI STUDIO / RIDER HUB</p><h1>PLATFORM <em>YÖNETİMİ.</em></h1></div>
@if(TempData["RiderInfo"] is string msg){<p class="rider-flash">@msg</p>}
<div class="rider-stat-grid"><div><span>ÜYELER</span><strong>@ViewBag.Members</strong></div><div><span>MOTOSİKLETLER</span><strong>@ViewBag.Bikes</strong></div><div><span>ROTALAR</span><strong>@ViewBag.Routes</strong></div><div><span>ONAY BEKLEYEN</span><strong>@ViewBag.Pending</strong></div></div>
<div class="rider-two"><section class="rider-panel"><h2>KATALOG · MARKA EKLE</h2><form class="rider-form" method="post" action="/yonetim/rider/marka">@Html.AntiForgeryToken()<label>Marka<input name="name" minlength="2" maxlength="75" required /></label><button class="rider-btn">MARKAYI EKLE</button></form>
<h2>MODEL EKLE</h2><form class="rider-form" method="post" action="/yonetim/rider/model">@Html.AntiForgeryToken()<label>Marka<select name="brandId">@foreach(var b in brands){<option value="@b.Id">@b.Name</option>}</select></label><label>Model<input name="name" minlength="2" maxlength="100" required /></label><button class="rider-btn">MODEL EKLE</button></form></section>
<section class="rider-panel"><h2>YIL / VERSİYON EKLE</h2><form class="rider-form" method="post" action="/yonetim/rider/versiyon">@Html.AntiForgeryToken()<label>Model<select name="modelId">@foreach(var b in brands){foreach(var m in b.Models.OrderBy(x=>x.Name)){<option value="@m.Id">@b.Name / @m.Name</option>}}</select></label><div class="rider-form-grid"><label>Yıl<input name="year" type="number" min="1950" max="2035" required /></label><label>Versiyon<input name="edition" value="Standart" required maxlength="85" /></label><label>Motor hacmi (cc)<input name="engineCc" type="number" min="1" max="2500" /></label><label>Güç (hp)<input name="powerHp" type="number" step="0.01" min="0" /></label><label>Tork (Nm)<input name="torqueNm" type="number" step="0.01" min="0" /></label><label>Depo (L)<input name="tankLitres" type="number" step="0.1" min="0.5" /></label></div><p class="rider-muted">Teknik özellikleri yalnızca doğrulanmış üretici verileriyle doldur.</p><button class="rider-btn">VERSİYONU EKLE</button></form></section></div>
<section class="rider-panel"><h2>KATALOG TOPLU İÇE AKTARMA</h2><p class="rider-muted">Marka, model, yıl ve teknik özellikleri CSV ile ekle. İthal edilen her değeri üretici kaynağından doğrulamış olmalısın. En fazla 250 satır / 200 KB.</p>
<form class="rider-form" action="/yonetim/rider/katalog-csv" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<label>CSV dosyası<input type="file" name="file" accept=".csv,text/csv" required /></label><button class="rider-btn">CSV KATALOĞU İÇE AKTAR ↗</button></form><p><a href="/katalog_sablon.csv" download>CSV ŞABLONUNU İNDİR ↗</a></p></section>
<section class="rider-panel"><h2>TOPLULUK ROTA ONAYLARI</h2>@if(!pending.Any()){<p class="rider-muted">Onay bekleyen rota bulunmuyor.</p>}<div class="rider-list">@foreach(var t in pending){<div class="rider-list-item"><span>⌖</span><span><strong>@t.Title</strong><small>@t.StartLabel → @t.EndLabel / @t.DistanceKm km · rota kullanıcı tarafından girilmiştir</small></span><form method="post" action="/yonetim/rider/rota-onay/@t.Id">@Html.AntiForgeryToken()<input type="hidden" name="approved" value="true" /><button class="rider-btn">ONAYLA</button></form><form method="post" action="/yonetim/rider/rota-onay/@t.Id">@Html.AntiForgeryToken()<input type="hidden" name="approved" value="false" /><button class="rider-delete">REDDET</button></form></div>}</div></section>
</section>
<section class="shell admin-shell"><div class="rider-panel"><h2>BENZİN FİYATI / YEDEK REFERANS</h2><p class="rider-muted">Çevrim içi kaynak güncel değilse, doğruladığınız fiyat 24 saat boyunca kaynak belirtilerek kullanılabilir. Kaynak doğrulanmadan fiyat girmeyin.</p><form class="rider-form" method="post" action="/yonetim/rider/yakit-fiyati">@Html.AntiForgeryToken()<div class="rider-form-grid"><label>İstanbul yakası<select name="side"><option value="anadolu">Anadolu</option><option value="avrupa">Avrupa</option></select></label><label>Litre fiyatı (₺)<input type="number" name="price" min="1" max="1000" step="0.01" required /></label><label>Doğrulama kaynağı<input name="source" required minlength="3" maxlength="150" placeholder="İstasyon veya yayımlanan fiyat kaynağı"/></label></div><button class="rider-btn">REFERANS FİYATI KAYDET</button></form>@foreach(var entry in (List<PlatformEntry>)ViewBag.FuelEntries){<p>@entry.Key.Replace("fuel:","") · @entry.UpdatedUtc.AddHours(3).ToString("dd.MM.yyyy HH:mm") · @(entry.UpdatedUtc>=DateTime.UtcNow.AddHours(-24)?"24 saat içinde":"Süresi doldu")</p>}</div>
<div class="rider-panel"><h2>KATALOG KAYITLARI</h2><p class="rider-muted">Marka ve modelleri açarak düzenleyin. Bağlı kayıt bulunan öğeler korunur.</p>
@foreach(var brand in brands){<details class="catalog-brand"><summary>@brand.Name (@brand.Models.Count model)</summary><div class="catalog-edit"><form method="post" action="/yonetim/rider/katalog/marka/@brand.Id/duzenle" class="catalog-edit">@Html.AntiForgeryToken()<label>Marka adı<input name="name" value="@brand.Name" required maxlength="75"/></label><button class="rider-btn">Güncelle</button></form><form method="post" action="/yonetim/rider/katalog/marka/@brand.Id/sil">@Html.AntiForgeryToken()<button class="rider-delete">Markayı sil</button></form></div>
@foreach(var bikeModel in brand.Models.OrderBy(x=>x.Name)){<details class="catalog-model"><summary>@bikeModel.Name (@bikeModel.Variants.Count versiyon)</summary><div class="catalog-edit"><form method="post" action="/yonetim/rider/katalog/model/@bikeModel.Id/duzenle" class="catalog-edit">@Html.AntiForgeryToken()<label>Model adı<input name="name" value="@bikeModel.Name" required maxlength="100"/></label><button class="rider-btn">Güncelle</button></form><form method="post" action="/yonetim/rider/katalog/model/@bikeModel.Id/sil">@Html.AntiForgeryToken()<button class="rider-delete">Modeli sil</button></form></div>
@foreach(var v in bikeModel.Variants.OrderByDescending(x=>x.Year)){<div class="catalog-model"><form method="post" action="/yonetim/rider/katalog/versiyon/@v.Id/duzenle" class="catalog-edit">@Html.AntiForgeryToken()<label>Yıl<input type="number" name="year" value="@v.Year" min="1950" max="2035" required/></label><label>Versiyon<input name="edition" value="@v.Edition" maxlength="85" required/></label><label>cc<input name="engineCc" type="number" value="@v.EngineCc" min="1" max="2500"/></label><label>hp<input name="powerHp" type="number" step="0.01" value="@(v.PowerHp?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" max="1000"/></label><label>Nm<input name="torqueNm" type="number" step="0.01" value="@(v.TorqueNm?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" max="1000"/></label><label>Depo (L)<input name="tankLitres" type="number" step="0.01" value="@(v.TankLitres?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0.5" max="150"/></label><button class="rider-btn">Güncelle</button></form><form method="post" action="/yonetim/rider/katalog/versiyon/@v.Id/sil">@Html.AntiForgeryToken()<button class="rider-delete">Versiyonu sil</button></form></div>}
</details>}
</details>}
</div></section>
