@model AdminPlatformVm
@{Layout="_AdminLayout"; var maxPage=Math.Max(1,(Model.Total+29)/30);}
<section class="shell admin-shell"><partial name="_AdminNav"/>
<div class="admin-table-head"><div><h2>@Model.Total kayıt</h2><p>@(Model.Section=="islemler"?"Yönlendirme ile sonuçlanan yönetim işlemleri; ayrıntılı adli kayıt değildir.":"Arama, kayıt yönetimi ve güvenli işlem onayı.")</p></div><form method="get" class="platform-search"><input name="q" value="@Model.Query" maxlength="100" placeholder="Kayıtlarda ara" aria-label="Kayıtlarda ara"/><button class="btn btn-mint">Ara</button></form></div>
<div class="admin-table-wrap"><table class="admin-table"><thead>
@if(Model.Section=="uyeler"){<tr><th>Üye</th><th>Üyelik</th><th>Durum</th><th>İşlemler</th></tr>}
else if(Model.Section=="motosikletler"){<tr><th>Motosiklet</th><th>Sahibi</th><th>Kilometre</th><th>İşlemler</th></tr>}
else if(Model.Section=="rotalar"){<tr><th>Rota</th><th>Üye</th><th>Durum</th><th>İşlemler</th></tr>}
else{<tr><th>İşlem</th><th>Tarih (Türkiye)</th></tr>}
</thead><tbody>
@if(Model.Total==0){<tr><td colspan="4">Kayıt bulunamadı.</td></tr>}
@foreach(var u in Model.Members){var blocked=u.LockoutEnd.HasValue&&u.LockoutEnd.Value>DateTimeOffset.UtcNow;<tr><td><strong>@u.DisplayName</strong><small>@u.Email</small></td><td>@u.JoinedUtc.ToString("dd.MM.yyyy")</td><td><span class="status @(blocked?"status-draft":"status-live")">@(blocked?"Engelli":u.EmailConfirmed?"Doğrulanmış":"Onay bekliyor")</span></td><td class="table-actions"><form method="post" action="/yonetim/rider/uye/@u.Id/durum" data-confirm="Üyelik durumunu değiştirmek istediğinizden emin misiniz?">@Html.AntiForgeryToken()<input type="hidden" name="blocked" value="@(blocked?"false":"true")"/><button>@(blocked?"Engeli kaldır":"Engelle")</button></form><form method="post" action="/yonetim/rider/uye/@u.Id/sifirla">@Html.AntiForgeryToken()<button>Şifre sıfırlama gönder</button></form><form method="post" action="/yonetim/rider/uye/@u.Id/sil" data-confirm="Üye, garaj, rotalar ve bağlı kayıtlar kalıcı olarak silinecek. Emin misiniz?">@Html.AntiForgeryToken()<button class="rider-delete">Sil</button></form></td></tr>}
@foreach(var b in Model.Bikes){<tr><td><strong>@b.BrandName @b.ModelName</strong><small>@b.ModelYear · @b.Edition</small></td><td>@b.Owner.DisplayName<small>@b.Owner.Email</small></td><td>@b.OdometerKm.ToString("N0") km</td><td><form method="post" action="/yonetim/rider/motor/@b.Id/sil" data-confirm="Motosiklet ve yakıt, bakım, gider kayıtları silinecek. Rotalar korunacak. Emin misiniz?">@Html.AntiForgeryToken()<button class="rider-delete">Sil</button></form></td></tr>}
@foreach(var t in Model.Trips){<tr><td><strong>@t.Title</strong><small>@t.DistanceKm km · @t.CreatedUtc.ToString("dd.MM.yyyy")</small></td><td>@Model.Names.GetValueOrDefault(t.OwnerId,"Silinmiş üye")</td><td>@(t.IsPublic?(t.IsApproved?"Yayında":"Onay bekliyor"):"Özel")</td><td class="table-actions">@if(t.IsPublic){<form method="post" action="/yonetim/rider/rota/@t.Id/yayini-kaldir">@Html.AntiForgeryToken()<button>Yayından kaldır</button></form>}<form method="post" action="/yonetim/rider/rota/@t.Id/sil" data-confirm="Rota kalıcı olarak silinecek. Emin misiniz?">@Html.AntiForgeryToken()<button class="rider-delete">Sil</button></form></td></tr>}
@foreach(var a in Model.Audits){<tr><td>@a.Operation</td><td>@a.CreatedUtc.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss")</td></tr>}
</tbody></table></div><nav class="platform-pagination" aria-label="Sayfalar">@if(Model.Page>1){<a href="?page=@(Model.Page-1)&q=@Uri.EscapeDataString(Model.Query)">← Önceki</a>}<span>Sayfa @Model.Page / @maxPage</span>@if(Model.Page<maxPage){<a href="?page=@(Model.Page+1)&q=@Uri.EscapeDataString(Model.Query)">Sonraki →</a>}</nav></section>
