@inject IConfiguration Cfg
@{var title=(string?)ViewData["Title"]??"Kontrol Merkezi";var login=Context.Request.Path.StartsWithSegments("/yonetim/giris");var current=Context.Request.Path.Value??"";var enabled=Cfg.GetValue<bool>("Rider:Enabled");var groups=new (string Label,string Path,string Icon)[]{("Genel bakış","/yonetim","▦"),("Kullanıcılar","/yonetim/rider/uyeler","♙"),("Motosikletler","/yonetim/rider/motosikletler","◉"),("Kullanıcı rotaları","/yonetim/rider/rotalar","⌖"),("Katalog ve onaylar","/yonetim/rider","▤"),("Videolar","/yonetim/icerikler/videolar","▷"),("Gezi yazıları","/yonetim/icerikler/rotalar","⌁"),("Fotoğraf albümleri","/yonetim/icerikler/albumler","▧"),("Ekipman","/yonetim/icerikler/ekipmanlar","◇"),("Mesajlar","/yonetim/mesajlar","✉"),("Site ayarları","/yonetim/ayarlar","⚙"),("İşlem geçmişi","/yonetim/rider/islemler","≡"),("Yönetici şifresi","/yonetim/sifre","▣")};}
<!doctype html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>@title · MAMI STUDIO</title><link rel="icon" href="/favicon.svg"/><link rel="stylesheet" href="/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="/css/studio.css" asp-append-version="true"/><link rel="stylesheet" href="/css/rider.css" asp-append-version="true"/><link rel="stylesheet" href="/css/mono.css" asp-append-version="true"/><link rel="stylesheet" href="/css/v52-ui.css" asp-append-version="true"/><link rel="stylesheet" href="/css/admin-v52.css" asp-append-version="true"/></head>
<body class="admin-body studio-body @(login?"studio-login":"admin-v52")"><a class="skip-link" href="#main-content">İçeriğe geç</a>
@if(!login){<aside class="platform-sidebar" id="platform-sidebar"><a href="/yonetim" class="platform-brand"><img src="/logo-bike.svg" alt=""/><span><strong>MAMI STUDIO</strong><small>YÖNETİM PANELİ</small></span></a><div class="platform-nav-caption">ÇALIŞMA ALANI</div><nav aria-label="Yönetim menüsü">@foreach(var item in groups){if(!enabled&&item.Path.StartsWith("/yonetim/rider")){continue;}<a href="@item.Path" class="@(current==item.Path?"active":"")"><span aria-hidden="true">@item.Icon</span>@item.Label</a>}</nav><a class="platform-site-link" href="/" target="_blank" rel="noopener">Siteyi görüntüle ↗</a></aside><header class="platform-top"><button class="platform-menu" type="button" aria-controls="platform-sidebar" aria-expanded="false">☰ Menü</button><span class="platform-breadcrumb">MAMI STUDIO <b> / @title</b></span><span class="platform-user">● Yönetici</span><form action="/yonetim/cikis" method="post">@Html.AntiForgeryToken()<button type="submit">Çıkış yap</button></form></header>}
<main id="main-content">@RenderBody()</main><script src="/js/site.js" asp-append-version="true" defer></script><script src="/js/v52-ui.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
