@model DashboardVm
@{ Layout = "_AdminLayout"; }
<section class="shell admin-shell"><partial name="_AdminNav"/>@if(ViewBag.MemberCount is not null){<div class="admin-stats platform-stats"><a href="/yonetim/rider/uyeler"><small>KAYITLI ÜYELER</small><strong>@ViewBag.MemberCount</strong><span>ÜYELERİ YÖNET ↗</span></a><a href="/yonetim/rider/motosikletler"><small>KAYITLI MOTORLAR</small><strong>@ViewBag.BikeCount</strong><span>GARAJLARI YÖNET ↗</span></a><a href="/yonetim/rider/rotalar"><small>KAYITLI ROTALAR</small><strong>@ViewBag.RouteCount</strong><span>ROTALARI YÖNET ↗</span></a><a href="/yonetim/rider"><small>ONAY BEKLEYEN</small><strong>@ViewBag.PendingCount</strong><span>İNCELE ↗</span></a></div>}<h2 class="admin-subheading">Yayın ve içerik</h2><div class="admin-stats"><a href="/yonetim/icerikler/videolar"><small>VİDEOLAR</small><strong>@Model.Videos</strong><span>YÖNET ↗</span></a><a href="/yonetim/icerikler/rotalar"><small>GEZİ ROTALARI</small><strong>@Model.Rides</strong><span>YÖNET ↗</span></a><a href="/yonetim/icerikler/albumler"><small>ALBÜMLER</small><strong>@Model.Albums</strong><span>YÖNET ↗</span></a><a href="/yonetim/mesajlar"><small>OKUNMAMIŞ MESAJ</small><strong>@Model.Messages</strong><span>İNCELE ↗</span></a></div><div class="admin-quick"><h2>HIZLI İŞLEMLER</h2><div><a href="/yonetim/duzenle/videolar">+ Yeni video</a><a href="/yonetim/duzenle/rotalar">+ Yeni gezi yazısı</a><a href="/yonetim/duzenle/albumler">+ Yeni fotoğraf albümü</a></div></div><div class="admin-quick"><h2>SON MESAJLAR</h2>@if(Model.RecentMessages.Count==0){<p>Henüz mesaj yok.</p>}else{<div class="admin-message-list">@foreach(var m in Model.RecentMessages){<a href="/yonetim/mesajlar/@m.Id"><b>@m.Name</b><span>@m.Subject</span><small>@m.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small></a>}</div>}</div></section>
