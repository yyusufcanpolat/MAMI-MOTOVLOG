@model LoginVm
@{ Layout = "_AdminLayout"; }
<section class="admin-login shell"><div class="login-intro"><span class="overline">MAMI / KONTROL MERKEZİ</span><h1>YÖNETİM<br /><em>PANELİ.</em></h1><p>Yol hikâyelerini, videoları ve gelen mesajları tek bir yerden yönet.</p><img src="/images/rider-450sr.webp" alt="Motosiklet sürüşü" /></div><div class="login-panel"><span class="overline">GÜVENLİ GİRİŞ</span><h2>Tekrar hoş geldin.</h2><p>İçerikleri yönetmek için özel yönetim şifreni gir.</p>@if (TempData["Success"] is string success) { <div class="alert alert-good">@success</div> }<form asp-action="Login" asp-controller="Admin" method="post"><div asp-validation-summary="All" class="validation-error"></div><div class="field"><label asp-for="Password">ŞİFRE</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Şifreniz"/></div><button class="btn btn-mint" type="submit">PANELE GİR <span>→</span></button></form></div></section>
