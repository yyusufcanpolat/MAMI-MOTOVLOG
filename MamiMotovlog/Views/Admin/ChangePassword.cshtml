@model ChangePasswordVm
@{ Layout = "_AdminLayout"; }
<section class="shell admin-shell">
  <partial name="_AdminNav" />
  <div class="admin-table-head"><div><h2>ŞİFRE GÜNCELLE</h2><p>Yönetim paneli yalnızca tek yetkiliye açıktır. E-posta veya kullanıcı adı gerekli değildir.</p></div></div>
  <form asp-controller="Admin" asp-action="ChangePassword" method="post" class="admin-editor" autocomplete="off">
    <div asp-validation-summary="All" class="validation-error"></div>
    <div class="field"><label asp-for="CurrentPassword">MEVCUT ŞİFRE</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" required /><span asp-validation-for="CurrentPassword" class="validation-error"></span></div>
    <div class="field"><label asp-for="NewPassword">YENİ ŞİFRE (EN AZ 12 KARAKTER)</label><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required /><span asp-validation-for="NewPassword" class="validation-error"></span></div>
    <div class="field"><label asp-for="ConfirmPassword">YENİ ŞİFREYİ TEKRARLA</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /><span asp-validation-for="ConfirmPassword" class="validation-error"></span></div>
    <button type="submit" class="btn btn-mint">ŞİFREYİ GÜNCELLE <span>↗</span></button>
  </form>
</section>
