@model SiteSettings
@{ Layout = "_AdminLayout"; }
<section class="shell admin-shell"><partial name="_AdminNav"/><div class="admin-table-head"><div><h2>BAĞLANTILAR</h2><p>Muhammet'in doğrulanmış sosyal medya ve iletişim adreslerini ekle.</p></div></div><form asp-controller="Admin" asp-action="Settings" method="post" class="admin-editor"><div asp-validation-summary="All" class="validation-error"></div><div class="field"><label asp-for="YouTubeChannelUrl">YOUTUBE KANAL BAĞLANTISI</label><input asp-for="YouTubeChannelUrl" placeholder="https://www.youtube.com/@@kanal" type="url" maxlength="200"/></div><div class="field"><label asp-for="InstagramUrl">INSTAGRAM BAĞLANTISI</label><input asp-for="InstagramUrl" placeholder="https://www.instagram.com/..." type="url" maxlength="200"/></div><div class="field"><label asp-for="TikTokUrl">TIKTOK BAĞLANTISI</label><input asp-for="TikTokUrl" placeholder="https://www.tiktok.com/@@..." type="url" maxlength="200"/></div><div class="field"><label asp-for="ContactEmail">İLETİŞİM E-POSTASI</label><input asp-for="ContactEmail" type="email" maxlength="180" /></div><div class="field"><label asp-for="HeroTitle">ANA SAYFA BAŞLIĞI (boş: mevcut varsayılan)</label><input asp-for="HeroTitle" maxlength="100"/></div><div class="field"><label asp-for="HeroDescription">ANA SAYFA AÇIKLAMASI</label><textarea asp-for="HeroDescription" maxlength="550" rows="4"></textarea></div><div class="field"><label asp-for="AboutText">HAKKIMDA METNİ</label><textarea asp-for="AboutText" maxlength="2000" rows="7"></textarea></div><div class="field"><label asp-for="MotorcycleTitle">MOTOSİKLET SAYFASI BAŞLIĞI</label><input asp-for="MotorcycleTitle" maxlength="100"/></div><div class="field"><label asp-for="MotorcycleText">MOTOSİKLET SAYFASI METNİ (boş: varsayılan)</label><textarea asp-for="MotorcycleText" maxlength="4000" rows="8"></textarea></div><div class="field"><label asp-for="GuideTitle">YOL REHBERİ BAŞLIĞI</label><input asp-for="GuideTitle" maxlength="100"/></div><div class="field"><label asp-for="GuideText">YOL REHBERİ METNİ (boş: varsayılan)</label><textarea asp-for="GuideText" maxlength="8000" rows="8"></textarea></div><div class="field"><label>Kapak görseli</label><select name="HeroImage"><option value="@Model.HeroImage">Mevcut görseli koru</option><option value="">Varsayılan görsele dön</option></select></div><button type="submit" class="btn btn-mint">AYARLARI KAYDET <span>↗</span></button></form><div class="admin-quick"><h2>ANA SAYFA KAPAK GÖRSELİ</h2><img src="@(string.IsNullOrWhiteSpace(Model.HeroImage)?"/images/rider-450sr.webp":Model.HeroImage)" alt="Mevcut kapak" style="max-width:320px;width:100%;border-radius:8px"/><form action="/yonetim/kapak" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required/><button class="btn btn-mint">KAPAĞI DEĞİŞTİR</button></form></div></section>
