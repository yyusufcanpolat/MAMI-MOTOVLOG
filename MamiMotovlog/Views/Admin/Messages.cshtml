@model List<ContactMessage>
@{ Layout = "_AdminLayout"; }
<section class="shell admin-shell"><partial name="_AdminNav"/><div class="admin-table-head"><div><h2>İLETİŞİM KUTUSU</h2><p>Web sitesinden gönderilen mesajlar burada saklanır.</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>GÖNDEREN / KONU</th><th>TARİH</th><th>İŞLEM</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="3">Henüz mesaj yok.</td></tr>}@foreach(var m in Model){<tr><td><strong>@m.Name @(!m.IsRead?"• YENİ":"")</strong><small>@m.Subject — @m.Email @(!string.IsNullOrWhiteSpace(m.Phone) ? " · " + m.Phone : "")</small></td><td>@m.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td class="table-actions"><a href="/yonetim/mesajlar/@m.Id">OKU ↗</a><form action="/yonetim/mesajlar/@m.Id/sil" method="post" data-confirm="Mesaj silinsin mi?">@Html.AntiForgeryToken()<button>SİL</button></form></td></tr>}</tbody></table></div></section>
