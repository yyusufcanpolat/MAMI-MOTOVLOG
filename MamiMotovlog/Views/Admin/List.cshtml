@model AdminListVm
@{ Layout = "_AdminLayout"; }
<section class="shell admin-shell"><partial name="_AdminNav"/><div class="admin-table-head"><div><h2>@Model.KindTitle.ToUpperInvariant()</h2><p>Yeni kayıt ekle, mevcut içerikleri düzenle veya kaldır.</p></div><a class="btn btn-mint" href="/yonetim/duzenle/@Model.Kind">+ YENİ EKLE <span>↗</span></a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>BAŞLIK</th><th>DURUM</th><th>İŞLEM</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="3">Henüz içerik yok. İlk kaydını oluştur.</td></tr>}@foreach(var item in Model.Items){<tr><td><strong>@item.Title</strong><small>@item.Summary</small></td><td><span class="status @(item.Published?"status-live":"status-draft")">@(item.Published?"YAYINDA":"TASLAK")</span></td><td class="table-actions"><a href="/yonetim/duzenle/@Model.Kind/@item.Id">DÜZENLE ↗</a><form action="/yonetim/sil/@Model.Kind/@item.Id" method="post" data-confirm="Bu içerik silinsin mi?">@Html.AntiForgeryToken()<button type="submit">SİL</button></form></td></tr>}</tbody></table></div></section>
