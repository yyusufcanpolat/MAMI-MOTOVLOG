@model RiderMember
@{ ViewData["Title"] = "Hesabım ve gizlilik"; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER HUB / HESAP</p><h1>HESAP <em>AYARLARI.</em></h1></div>@await Html.PartialAsync("_RiderMenu")
@if(TempData["RiderInfo"] is string msg){<p class="rider-flash">@msg</p>}
<div class="rider-two"><div class="rider-panel"><h2>HESAP BİLGİLERİ</h2><p>Ad: <strong>@Model.DisplayName</strong></p><p>E-posta: <strong>@Model.Email</strong></p><p>Doğrulama: @(Model.EmailConfirmed?"E-posta doğrulandı":"Onay bekliyor")</p><p>Üyelik: @Model.JoinedUtc.ToString("dd.MM.yyyy")</p></div>
<div class="rider-panel"><h2>BAKIM E-POSTALARI</h2><form class="rider-form" method="post" action="/uye/bildirimler">@Html.AntiForgeryToken()<label>Bildirim tercihi<select name="enabled"><option value="true" selected="@((bool)ViewBag.ReminderEmails)">E-posta gönder</option><option value="false" selected="@(!(bool)ViewBag.ReminderEmails)">E-posta gönderme</option></select></label><button class="rider-btn">TERCİHİ KAYDET</button></form></div><div class="rider-panel"><h2>HESABIMI SİL</h2><p class="rider-muted">Bu işlem üyeliğini, motosikletlerini, kayıtlarını ve rotalarını kalıcı olarak siler. V2 kamuya açık içeriklerini etkilemez.</p><form class="rider-form" method="post" action="/uye/hesabi-sil" data-confirm="Hesabın ve tüm verilerin silinecek. Emin misin?">@Html.AntiForgeryToken()<label>Silme için şifren<input type="password" name="password" autocomplete="current-password" required /></label><button class="rider-btn rider-btn-ghost">HESABIMI VE VERİLERİMİ SİL</button></form></div></div>
</section>
