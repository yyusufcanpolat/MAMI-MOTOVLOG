@model List<RiderEquipment>
@{ ViewData["Title"] = "Kişisel ekipmanlarım"; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER GARAGE / EKİPMAN</p><h1>YOL <em>EKİPMANLARIM.</em></h1><p>Kaskından montuna, garanti sürelerini ve ekipman masraflarını tek yerde tut.</p></div>@await Html.PartialAsync("_RiderMenu")
<div class="rider-section-head"><h2>@Model.Count EKİPMAN</h2><a class="rider-btn" href="/garaj/ekipman-ekle">＋ EKİPMAN EKLE</a></div><div class="rider-cards">@foreach(var x in Model){<article class="rider-panel"><span class="overline">@x.Category</span>@if(!string.IsNullOrWhiteSpace(x.PhotoFileName)){<img class="rider-gear-photo" src="/garaj/ekipmanlar/@x.Id/fotograf" alt="@x.Brand @x.Model" loading="lazy" />}<h3>@x.Brand @x.Model</h3><p class="rider-muted">@(x.PurchasedOn.HasValue?"Alındı: "+x.PurchasedOn.Value.ToString("dd.MM.yyyy"):"Alış tarihi girilmedi")</p><p>Garanti: @(x.WarrantyEndsOn?.ToString("dd.MM.yyyy")??"—")</p><p>@(x.CostTry?.ToString("N2")??"—") ₺</p><form class="rider-form" action="/garaj/ekipmanlar/@x.Id/fotograf" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<label>Fotoğraf<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required /></label><button class="rider-btn rider-btn-ghost">FOTOĞRAF YÜKLE</button></form><form action="/garaj/ekipman-sil/@x.Id" method="post">@Html.AntiForgeryToken()<button class="rider-delete" data-confirm="Ekipmanı sil?">SİL</button></form></article>}</div>
@if(Model.Count==0){<div class="rider-panel"><p>Henüz ekipman kaydın yok.</p></div>}</section>
