@model RiderBikeDetailsVm
@{ var b=Model.Bike; ViewData["Title"] = b.BrandName+" "+b.ModelName+" · Garaj"; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER GARAGE / MOTOR KARTI</p><h1>@b.BrandName.ToUpperInvariant() <em>@b.ModelName.ToUpperInvariant()</em></h1><p>@b.ModelYear · @b.Edition · @b.OdometerKm.ToString("N0") KM</p></div>@await Html.PartialAsync("_RiderMenu")
@if(TempData["RiderInfo"] is string message){<div class="rider-flash">@message</div>}
<div class="rider-stat-grid"><div><span>KİLOMETRE</span><strong>@b.OdometerKm.ToString("N0")</strong><small>km</small></div><div><span>ORTALAMA TÜKETİM</span><strong>@(Model.ConsumptionL100?.ToString("N2")??"—")</strong><small>L/100 km · @(Model.ConsumptionMeasured ? $"{Model.ConsumptionIntervalCount} tam depo aralığından ölçüldü" : Model.ConsumptionL100.HasValue ? "Kullanıcının girdiği tahmin" : "Hesap için iki tam depo dolumu gerekir")</small></div><div><span>YAKIT MASRAFI</span><strong>@Model.Fuels.Sum(x=>x.TotalTry).ToString("N0")</strong><small>₺</small></div><div><span>BAKIM</span><strong>@Model.Maintenances.Count</strong><small>kayıt</small></div></div>
<div class="rider-actions"><a class="rider-btn" href="/garaj/motor/@b.Id/yakit">＋ YAKIT GİR</a><a class="rider-btn rider-btn-ghost" href="/garaj/motor/@b.Id/bakim">＋ BAKIM EKLE</a><a class="rider-btn rider-btn-ghost" href="/garaj/motor/@b.Id/gider">＋ GİDER EKLE</a><a class="rider-btn rider-btn-ghost" href="/garaj/motor/@b.Id/duzenle">DÜZENLE</a><a class="rider-btn rider-btn-ghost" href="/garaj/motor/@b.Id/bakim-raporu" target="_blank" rel="noopener">BAKIM RAPORU / PDF ↗</a></div>
<div class="rider-two"><section class="rider-panel"><h2>YAKIT GEÇMİŞİ</h2>@if(!Model.Fuels.Any()){<p class="rider-muted">Henüz yakıt kaydı yok.</p>}else{<div class="rider-table-wrap"><table class="rider-table"><tr><th>Tarih</th><th>KM</th><th>Litre</th><th>Tutar</th><th>Dolum</th><th></th></tr>@foreach(var x in Model.Fuels){<tr><td>@x.FuelledOn.ToString("dd.MM.yy")</td><td>@x.AtKm</td><td>@x.Litres.ToString("N2")</td><td>@x.TotalTry.ToString("N2") ₺</td><td><form method="post" action="/garaj/yakit/@x.Id/dolum">@Html.AntiForgeryToken()<input type="hidden" name="fullTank" value="@(!x.FullTank ? "true" : "false")"/><button class="rider-btn rider-btn-ghost" type="submit" title="Dolum türünü düzelt">@(x.FullTank ? "Tam depo" : "Kısmi") · değiştir</button></form></td><td><form method="post" action="/garaj/kayit-sil/yakit/@x.Id">@Html.AntiForgeryToken()<button class="rider-delete" data-confirm="Kaydı sil?">Sil</button></form></td></tr>}</table></div>}</section>
<section class="rider-panel"><h2>BAKIM GEÇMİŞİ</h2>@if(!Model.Maintenances.Any()){<p class="rider-muted">Henüz bakım kaydı yok.</p>}else{<div class="rider-table-wrap"><table class="rider-table"><tr><th>İşlem</th><th>Tarih</th><th>KM</th><th>Tutar</th><th></th></tr>@foreach(var x in Model.Maintenances){<tr><td>@x.Category</td><td>@x.ServicedOn.ToString("dd.MM.yy")</td><td>@x.AtKm</td><td>@x.CostTry.ToString("N0") ₺</td><td>@if(!string.IsNullOrEmpty(x.AttachmentFileName)){<a href="/garaj/bakim/@x.Id/belge" target="_blank" rel="noopener">BELGE ↗</a>}
<form method="post" action="/garaj/bakim/@x.Id/belge" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="file" name="document" accept=".pdf,.jpg,.png,.webp" aria-label="Bakım belgesi" required /><button class="rider-delete">Yükle</button></form>
<form method="post" action="/garaj/kayit-sil/bakim/@x.Id">@Html.AntiForgeryToken()<button class="rider-delete" data-confirm="Kaydı sil?">Sil</button></form></td></tr>}</table></div>}</section></div>
<section class="rider-panel"><h2>DİĞER GİDERLER</h2>@if(!Model.Expenses.Any()){<p class="rider-muted">Henüz gider kaydı yok.</p>}else{<div class="rider-table-wrap"><table class="rider-table"><tr><th>Tür</th><th>Açıklama</th><th>Tarih</th><th>₺</th><th></th></tr>@foreach(var x in Model.Expenses){<tr><td>@x.Category</td><td>@x.Description</td><td>@x.SpentOn.ToString("dd.MM.yy")</td><td>@x.AmountTry.ToString("N0")</td><td><form method="post" action="/garaj/kayit-sil/gider/@x.Id">@Html.AntiForgeryToken()<button class="rider-delete" data-confirm="Kaydı sil?">Sil</button></form></td></tr>}</table></div>}</section>
<form class="rider-danger" method="post" action="/garaj/motor/@b.Id/sil" data-confirm="Motosiklet ve bütün yakıt/bakım/gider kayıtları silinecek. Emin misin?">@Html.AntiForgeryToken()<button>BU MOTOSİKLETİ SİL</button></form>
</section>
