@model RiderYearVm
@{ ViewData["Title"] = "Yıllık sürüş özeti"; string[] months=["OCA","ŞUB","MAR","NİS","MAY","HAZ","TEM","AĞU","EYL","EKİ","KAS","ARA"]; var max=Math.Max(1m,Model.MonthlyDistancesKm.Max()); }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER HUB / YILLIK ÖZET</p><h1>@Model.Year <em>YOLLARIM.</em></h1><p>Tamamlanan yolculuklardan, yakıt ve gider kayıtlarından hesaplanan kişisel özet.</p></div>@await Html.PartialAsync("_RiderMenu")
<form method="get" action="/garaj/yil-ozeti" class="rider-year-filter"><label>Yıl <input type="number" name="year" value="@Model.Year" min="2000" max="2100" /></label><button class="rider-btn">GÖSTER</button></form>
<div class="rider-stat-grid"><div><span>TAMAMLANAN</span><strong>@Model.CompletedTrips</strong><small>kayıtlı sürüş</small></div><div><span>TOPLAM MESAFE</span><strong>@Model.CompletedDistanceKm.ToString("N0")</strong><small>km · tahmini güzergâh</small></div><div><span>YAKIT</span><strong>@Model.FuelTry.ToString("N0")</strong><small>₺</small></div><div><span>TOPLAM GİDER</span><strong>@((Model.FuelTry+Model.MaintenanceTry+Model.ExpensesTry).ToString("N0"))</strong><small>₺</small></div></div>
<section class="rider-panel"><h2>AYLIK ROTA KİLOMETRESİ</h2><div class="rider-bars">@for(int i=0;i<12;i++){<div><span class="rider-bar" style="height:@((Model.MonthlyDistancesKm[i]/max*100m).ToString("0",System.Globalization.CultureInfo.InvariantCulture))%" title="@Model.MonthlyDistancesKm[i].ToString("N0") km"></span><small>@months[i]</small></div>}</div><p class="rider-muted">Yalnızca “tamamlandı” olarak işaretlediğin rota mesafeleri dahil edilir; GPS ölçümü değildir.</p></section>
<section class="rider-panel"><h2>GİDER DAĞILIMI</h2><p>Yakıt: <b>@Model.FuelTry.ToString("N2") ₺</b></p><p>Bakım: <b>@Model.MaintenanceTry.ToString("N2") ₺</b></p><p>Diğer: <b>@Model.ExpensesTry.ToString("N2") ₺</b></p></section></section>
