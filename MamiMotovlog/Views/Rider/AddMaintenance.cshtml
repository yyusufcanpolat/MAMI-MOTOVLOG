@model RiderMaintenanceVm
@{ ViewData["Title"] = "Bakım kaydı"; }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER GARAGE / SERVİS</p><h1>BAKIM <em>KAYDI.</em></h1></div>@await Html.PartialAsync("_RiderMenu")
<form class="rider-panel rider-form" method="post" action="/garaj/bakim">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="rider-errors"></div><input asp-for="BikeId" type="hidden" />
<div class="rider-form-grid"><label>Bakım tipi<select asp-for="Category" required><option value="">Seç</option><option>Yağ değişimi</option><option>Zincir bakımı</option><option>Fren bakımı</option><option>Lastik değişimi</option><option>Akü</option><option>Genel servis</option><option>Diğer</option></select></label><label>Bakım tarihi<input asp-for="Date" required type="date" /></label><label>İşlem kilometresi<input asp-for="OdometerKm" required type="number" /></label><label>Tutar ₺ (isteğe bağlı)<input asp-for="CostTry" type="number" step="0.01" min="0" /></label><label>Bir sonraki bakım tarihi (isteğe bağlı)<input asp-for="NextDate" type="date" /></label><label>Bir sonraki bakım KM (isteğe bağlı)<input asp-for="NextKm" type="number" /></label></div><label>İşlem açıklaması<textarea asp-for="Description" maxlength="300"></textarea></label><button class="rider-btn">BAKIMI KAYDET ↗</button></form></section>
