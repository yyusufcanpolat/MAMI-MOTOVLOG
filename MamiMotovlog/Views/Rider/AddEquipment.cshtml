@model RiderGearVm
@{ ViewData["Title"] = "Ekipman ekle"; }
<section class="rider-shell"><div class="rider-intro"><h1>EKİPMAN <em>EKLE.</em></h1></div>@await Html.PartialAsync("_RiderMenu")
<form class="rider-panel rider-form" action="/garaj/ekipman-ekle" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="rider-errors"></div><div class="rider-form-grid"><label>Kategori<select asp-for="Category" required><option value="">Seç</option><option>Kask</option><option>Mont</option><option>Eldiven</option><option>Bot</option><option>Kamera</option><option>İletişim cihazı</option><option>Diğer</option></select></label><label>Marka<input asp-for="Brand" required /></label><label>Model<input asp-for="Model" required /></label><label>Alış tarihi<input asp-for="PurchasedOn" type="date" /></label><label>Garanti bitişi<input asp-for="WarrantyEndsOn" type="date" /></label><label>Tutar ₺<input asp-for="CostTry" type="number" step="0.01" /></label></div><button class="rider-btn">EKİPMANI KAYDET ↗</button></form></section>
