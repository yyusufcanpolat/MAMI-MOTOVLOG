@model List<RiderReminder>
@inject MamiMotovlog.Data.RiderDbContext RiderDb
@using System.Security.Claims
@{ ViewData["Title"] = "Hatırlatmalar"; var uid = User.FindFirstValue(ClaimTypes.NameIdentifier); var bikes = await RiderDb.RiderBikes.AsNoTracking().Where(x=>x.OwnerId==uid).ToListAsync(); }
<section class="rider-shell"><div class="rider-intro"><p class="overline">RIDER GARAGE / TAKİP</p><h1>ZAMANI <em>KAÇIRMA.</em></h1><p>Sigorta, muayene ve garanti hatırlatmalarını ekle. Bakım uyarıları kilometre kayıtlarından ayrıca hesaplanır.</p></div>@await Html.PartialAsync("_RiderMenu")
@if(TempData["RiderInfo"] is string info){<p class="rider-flash">@info</p>}
<form method="post" action="/garaj/hatirlaticilar" class="rider-panel rider-form">@Html.AntiForgeryToken()<div class="rider-form-grid"><label>Motosiklet<select name="bikeId" required>@foreach(var b in bikes){<option value="@b.Id">@b.BrandName @b.ModelName</option>}</select></label><label>Tür<select name="kind"><option>Sigorta</option><option>Muayene</option><option>Garanti</option><option>Diğer</option></select></label><label>Hatırlatma<input name="title" maxlength="180" required /></label><label>Tarih<input type="date" name="date" required /></label></div><button class="rider-btn" @(bikes.Count==0?"disabled":"")>HATIRLATICI EKLE ↗</button></form>
<section class="rider-panel"><h2>TAKVİMİM</h2><div class="rider-list">@foreach(var x in Model){<div class="rider-list-item"><span>◷</span><span><strong>@x.Title</strong><small>@x.Kind · @x.DueOn.ToString("dd.MM.yyyy")</small></span><form method="post" action="/garaj/hatirlaticilar/@x.Id/sil">@Html.AntiForgeryToken()<button class="rider-delete">Sil</button></form></div>}</div>@if(!Model.Any()){<p class="rider-muted">Hatırlatma bulunmuyor.</p>}</section></section>
